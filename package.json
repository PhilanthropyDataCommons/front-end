{
	"name": "front-end",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "npm run start --workspace=apps",
		"test": "npm run --workspaces --if-present test",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:eslint": "npm run --workspaces --if-present lint:eslint",
		"lint:prettier": "npm run --workspaces --if-present lint:prettier",
		"lint:tsc": "npm run --workspaces --if-present lint:tsc",
		"format": "npm run --workspaces --if-present format",
		"build": "npm run --workspaces --if-present build"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-onboarding": "^10.6.0",
		"@storybook/vue3-vite": "^10.6.0",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.19.0",
		"@types/luxon": "^3.7.5",
		"@types/qs": "^6.15.1",
		"typescript-eslint": "^8.70.1",
		"eslint": "^v9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"@vue/tsconfig": "^0.9.1",
		"eslint-config-love": "154.1.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-storybook": "^10.6.0",
		"eslint-plugin-vue": "^10.11.1",
		"jsdom": "^30.1.1",
		"keycloak-js": "^26.2.3",
		"prettier": "^3.9.9",
		"storybook": "^10.4.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^4.1.11",
		"vue-eslint-parser": "^10.4.1",
		"vue-tsc": "^3.3.11"
	}
}
