{
	"name": "@pdc/admin-interface",
	"version": "0.0.0",
	"private": true,
	"dependencies": {
		"@dsb-norge/vue-keycloak-js": "^3.0.8",
		"@fontsource/source-sans-pro": "^5.3.0",
		"@heroicons/vue": "^2.2.0",
		"@pdc/components": "*",
		"@pdc/sdk": "^0.39.1",
		"@pdc/utilities": "*",
		"luxon": "^3.7.2",
		"vue": "^3.5.40",
		"vue-router": "^5.2.0"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"start": "vite",
		"build": "npm run build:app",
		"build:app": "vue-tsc && vite build",
		"lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:tsc",
		"lint:prettier": "prettier . --check --ignore-path ../../.gitignore",
		"lint:eslint": "eslint --report-unused-disable-directives --max-warnings 0",
		"lint:tsc": "vue-tsc --noEmit",
		"format": "npm run format:prettier && npm run format:eslint",
		"format:prettier": "prettier . --write  --ignore-path ../../.gitignore",
		"format:eslint": "eslint --fix || true",
		"preview": "vite preview",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
